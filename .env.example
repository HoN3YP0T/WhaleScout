# Postgres connection used by Prisma
DATABASE_URL="postgresql://whale:whale@localhost:5432/whale_sniper?schema=public"

# Feed provider. "mock" (default) replays deterministic scripted scenarios -
# no credentials needed. "helius" subscribes to real pump.fun buy/sell
# activity over Helius's RPC/WS (see HeliusFeedProvider.ts) and REQUIRES
# HELIUS_API_KEY below - if FEED_PROVIDER=helius and HELIUS_API_KEY is empty,
# the app refuses to start rather than silently falling back to mock.
FEED_PROVIDER=mock

# Helius API key (https://helius.dev) - only read when FEED_PROVIDER=helius.
# Empty by default; no real key is configured in this build.
HELIUS_API_KEY=

# Any other Solana JSON-RPC endpoint, used INSTEAD of Helius by everything
# that talks to RPC (live feed, dexscreener+rpc, solana-rpc relationships)
# and accepted in place of HELIUS_API_KEY. The public
# https://api.mainnet-beta.solana.com works for the live feed and for
# testing, but rate-limits RPC-heavy providers hard. SOLANA_WS_URL defaults
# to SOLANA_RPC_URL with http(s) -> ws(s).
SOLANA_RPC_URL=
SOLANA_WS_URL=

# Token data provider for TokenStatsCollector's external metadata (liquidity,
# market cap, holder concentration, mint/freeze authority, creator identity).
# "mock" (default) uses deterministic pseudo-random data - no network calls.
# "dexscreener" calls DexScreener's free public API (no key required) for
# liquidity/market-cap and falls back to conservative "risky" defaults for
# the fields DexScreener doesn't provide (holder count, concentration,
# authority state) - see DexScreenerTokenMetadataProvider.ts.
#
# "dexscreener+rpc" is the RECOMMENDED real-data option (REQUIRES
# HELIUS_API_KEY above - no second key, no paid API). It merges the two
# sources field-by-field: liquidity/market cap from DexScreener, and holder
# count, top-10 concentration and mint/freeze authority state from standard
# Solana RPC over your existing Helius endpoint. Why it matters: on
# "dexscreener" alone, the four fields DexScreener cannot answer fall back
# to worst-case values, which max out concentrationRisk (weight .20) and
# authorityRisk (weight .15) and so put a flat 35-point floor under every
# token's risk score - against tokenThresholds.maxTokenRiskScore of 55 that
# floor rejects essentially every realistic pump.fun token (a 6h-old token
# with $50k liquidity and 30 buyers scores 66 and is rejected; with real
# holder/authority data the same token scores 37 and passes). Solana RPC
# cannot price a pool, which is why this merges with DexScreener rather
# than replacing it. If TOKEN_DATA_PROVIDER=dexscreener+rpc and
# HELIUS_API_KEY is empty, the app refuses to start - see
# solanaRpcTokenMetadataProvider.ts.
#
# "solscan" calls Solscan's paid Pro API v2.0 (REQUIRES SOLSCAN_API_KEY below) and can supply
# all of the above plus creator address/serial-deployer launch count - if
# TOKEN_DATA_PROVIDER=solscan and SOLSCAN_API_KEY is empty, the app refuses
# to start rather than silently falling back - see
# SolscanTokenMetadataProvider.ts.
TOKEN_DATA_PROVIDER=mock

# Solscan Pro API key (https://pro-api.solscan.io) - only read when
# TOKEN_DATA_PROVIDER=solscan. Empty by default; no real key is configured
# in this build.
SOLSCAN_API_KEY=

# Wallet relationship source for cluster/manipulation detection.
# "mock" (default) is MockWalletRelationshipSource, whose funder/creator
# maps are only ever populated by scenario setup - which means that in
# production two of cluster-detect's four edge detectors are inert:
# commonFunderEdges (weight 0.9) and sharedCreatorEdges (weight 1.0), the
# two signals that alone clear clusterThresholds.edgeMergeThreshold (0.5)
# and force a merge. With them empty the creatorAssociatedWallets flag can
# never fire, so whale-discovery's wash-trading auto-reject check never
# fires either.
#
# "solana-rpc" derives both relationships from on-chain history over your
# existing Helius endpoint (REQUIRES HELIUS_API_KEY above - no second key,
# no paid API): a wallet's original funder from the earliest transaction in
# its signature history, and a token's deployer from the fee payer of the
# mint's creation transaction. Both facts are immutable, so they are cached
# permanently with no TTL - one lookup per address for the whole process
# lifetime. Lookups run in the background and reads are synchronous, so the
# hot trade path never blocks; pagination is capped (see
# solanaRpcWalletRelationshipSource.ts) so one lookup costs at most 5 RPC
# calls, and it shares one rate-limit governor with dexscreener+rpc rather
# than spending a second quota. If WALLET_RELATIONSHIP_SOURCE=solana-rpc
# and HELIUS_API_KEY is empty, the app refuses to start.
WALLET_RELATIONSHIP_SOURCE=mock

# Telegram bot: notifications/control only, never in the execution critical
# path. Leave TELEGRAM_BOT_TOKEN unset in dev - the bot module simply does
# not start and everything else keeps working. TELEGRAM_CHAT_ID is both
# where notifications go and the ONLY chat allowed to issue commands
# (/pause, /kill, /approve, ...); unset, commands are disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading is disabled by default. Do not flip this on without a real
# feed provider, a funded gated hot wallet, and a full review of
# packages/execution/src/liveExecutionAdapter.ts.
LIVE_TRADING_ENABLED=false
HOT_WALLET_KEYPAIR_PATH=
HOT_WALLET_MAX_BALANCE_USD=

LOG_LEVEL=info
HEALTH_PORT=3001
